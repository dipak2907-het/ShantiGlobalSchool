# Public browser variables
NEXT_PUBLIC_SUPABASE_URL=PLACEHOLDER
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PLACEHOLDER

# Server-only variables. Never expose these in browser code or commit real values.
SUPABASE_URL=PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER
# Optional chatbot provider secret. Also configure as a Cloudflare runtime secret for production.
GEMINI_API_KEY=PLACEHOLDER
# Optional Gemini model name. Leave unset to use the project's documented default.
GEMINI_MODEL=gemini-2.5-flash
